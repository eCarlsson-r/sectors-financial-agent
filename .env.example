# ── Database (Prisma) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/quoteplot

# ── Sectors API ────────────────────────────────────────────────────────────────
SECTORS_API_KEY=your_sectors_api_key_here
SECTORS_BASE_URL=https://api.sectors.app/v2

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to 'openai' or 'anthropic'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
CACHE_TTL_TICKERS=60
CACHE_TTL_HISTORICAL=300
CACHE_TTL_BENCHMARKS=120

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
